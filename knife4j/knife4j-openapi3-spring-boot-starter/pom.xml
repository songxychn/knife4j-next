    <artifactId>knife4j-openapi3-spring-boot-starter</artifactId>
    <name>knife4j-openapi3-spring-boot-starter</name>
    <description>Spring Boot autoconfigure</description>
    <dependencies>
        <!-- Compile dependencies -->
