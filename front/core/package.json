{
  "name": "knife4j-core",
  "version": "5.0.0-snapshot",
  "description": "Core utilities for the Knife4j OpenAPI UI.",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "repository": {
    "type": "git",
    "url": "https://github.com/xiaoymin/knife4j"
  },
  "scripts": {
    "test": "jest --config jestconfig.json",
    "build": "tsc",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "lint": "eslint src",
    "prepare": "bun run build",
    "prepublishOnly": "bun test && bun run lint",
    "preversion": "bun run lint",
    "version": "bun run format && git add -A src",
    "postversion": "git push && git push --tags"
  },
  "keywords": [
    "knife4j",
    "OpenAPI3"
  ],
  "files": [
    "lib/**/*"
  ],
  "author": "xiaoymin@foxmail.com",
  "license": "Apache-2.0",
  "devDependencies": {
    "@types/jest": "^29.4.0",
    "@typescript-eslint/eslint-plugin": "8.71.1",
    "@typescript-eslint/parser": "8.71.1",
    "eslint": "10.12.0",
    "eslint-plugin-prettier": "^4.2.1",
    "jest": "^29.4.3",
    "prettier": "^3.9.9",
    "ts-jest": "^29.4.14",
    "typescript": "5.9.3",
    "@eslint/js": "10.0.1"
  },
  "dependencies": {
    "@types/crypto-js": "^4.1.1",
    "@types/lodash": "^4.17.25",
    "class-transformer": "^0.5.1",
    "crypto-js": "^4.1.1",
    "lodash": "^4.17.21"
  }
}
