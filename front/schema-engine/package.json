{
  "name": "knife4j-schema-engine",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Registry-only JSON Schema 2020-12 engine for Knife4j OpenAPI 3.1 consumers.",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js"
    },
    "./uri": {
      "types": "./lib/uri.d.ts",
      "import": "./lib/uri.js"
    }
  },
  "files": [
    "lib/**/*"
  ],
  "scripts": {
    "build": "node ../scripts/tsc.cjs -p tsconfig.json",
    "prepare": "bun run build",
    "test": "vitest run",
    "check:browser": "bun run scripts/check-browser.ts",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.{ts,json}\" \"scripts/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.{ts,json}\" \"scripts/**/*.ts\"",
    "lint": "eslint . --max-warnings 0"
  },
  "license": "Apache-2.0",
  "dependencies": {
    "@hyperjump/browser": "1.5.1",
    "@hyperjump/json-schema": "1.18.0",
    "@hyperjump/uri": "1.3.9"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "8.71.2",
    "@typescript-eslint/parser": "8.71.2",
    "eslint": "10.12.0",
    "prettier": "^3.9.9",
    "@typescript/native": "npm:typescript@7.0.2",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "vitest": "^4.1.12",
    "@eslint/js": "10.0.1",
    "globals": "13.24.0"
  }
}
