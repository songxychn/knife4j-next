{
  "name": "knife4j-schema-engine",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Registry-only JSON Schema 2020-12 engine for Knife4j OpenAPI 3.1 consumers.",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js"
    }
  },
  "files": [
    "lib/**/*"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepare": "bun run build",
    "test": "vitest run",
    "check:browser": "bun run scripts/check-browser.ts",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.{ts,json}\" \"scripts/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.{ts,json}\" \"scripts/**/*.ts\"",
    "lint": "eslint . --ext .ts --max-warnings 0"
  },
  "license": "Apache-2.0",
  "dependencies": {
    "@hyperjump/browser": "1.5.0",
    "@hyperjump/json-schema": "1.17.8",
    "@hyperjump/uri": "1.3.5"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^7.6.0",
    "@typescript-eslint/parser": "^7.6.0",
    "eslint": "^8.45.0",
    "prettier": "^3.9.6",
    "typescript": "5.9.3",
    "vitest": "^4.1.10"
  }
}
