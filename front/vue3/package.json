{
  "name": "knife4j-vue3",
  "private": true,
  "version": "0.0.0",
  "scripts": {
    "dev": "node scripts/check-node.mjs && vite",
    "check:i18n": "bun scripts/check-i18n.mjs",
    "check:search-menu": "bun scripts/check-search-menu.mjs",
    "check:markdown": "node scripts/check-markdown.mjs",
    "check:codegen": "node scripts/check-codegen.mjs",
    "check:router": "node scripts/check-router.mjs",
    "check:store": "bun scripts/check-store.mjs",
    "build": "node scripts/check-node.mjs && vite build",
    "build:SpringDocOpenApi": "node scripts/check-node.mjs && cross-env VITE_RELEASE_APP_TYPE=SpringDocOpenApi vite build",
    "build:Knife4jSpringUi": "node scripts/check-node.mjs && cross-env VITE_RELEASE_APP_TYPE=Knife4jSpringUi vite build",
    "build:Knife4jJFinal": "node scripts/check-node.mjs && cross-env VITE_RELEASE_APP_TYPE=Knife4jJFinal vite build",
    "build:Knife4jFront": "node scripts/check-node.mjs && cross-env VITE_RELEASE_APP_TYPE=Knife4jFront vite build",
    "preview": "node scripts/check-node.mjs && vite preview",
    "check:node": "node scripts/check-node.mjs",
    "check:webjar-resources": "node --test scripts/check-webjar-resources.test.mjs"
  },
  "dependencies": {
    "@ant-design/icons-vue": "7.0.1",
    "@babel/generator": "8.0.6",
    "@vue/devtools-api": "8.2.1",
    "ace-builds": "1.44.0",
    "ant-design-vue": "4.2.6",
    "ast-types": "0.16.3",
    "async": "^3.2.4",
    "axios": "^1.20.0",
    "clipboard": "^2.0.11",
    "dayjs": "^1.11.23",
    "js-md5": "0.9.2",
    "json5": "^2.2.3",
    "localforage": "^1.10.0",
    "lodash": "^4.17.21",
    "marked": "18.1.1",
    "mermaid": "12.2.0",
    "pinia": "4.1.0",
    "qs": "^6.16.1",
    "vue": "^3.5.44",
    "vue-i18n": "11.4.14",
    "vue-router": "5.4.0",
    "vue3-ace-editor": "^2.2.2",
    "xml2js": "^0.6.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "6.0.10",
    "@vitejs/plugin-vue-jsx": "5.1.6",
    "cross-env": "^7.0.3",
    "less": "^4.9.1",
    "unplugin-vue-components": "32.1.0",
    "vite": "8.3.4",
    "vite-plugin-compression": "^0.5.1",
    "vite-plugin-remove-console": "^2.1.1",
    "jsdom": "30.1.3"
  },
  "engines": {
    "node": "^24.15.0 || >=26.0.0"
  },
  "overrides": {
    "@babel/core": "7.29.6",
    "baseline-browser-mapping": "2.11.0",
    "browserslist": "4.28.7",
    "follow-redirects": "1.16.1",
    "probe-image-size": "7.4.0",
    "qs": "6.16.1"
  }
}
